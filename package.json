{
  "name": "mola-cafe",
  "version": "0.1.11",
  "private": true,
  "author": "Merkut Studios",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --masaustu",
    "dev:lan": "tsx server/index.ts --lan --masaustu",
    "merkez": "tsx server/merkez/index.ts --build",
    "merkez:dev": "tsx server/merkez/index.ts",
    "merkez:import": "tsx scripts/merkez-import.ts",
    "merkez:restore": "tsx scripts/merkez-restore.ts",
    "merkez:sifre-sifirla": "tsx scripts/merkez-sifre-sifirla.ts",
    "merkez:kurtarma-kodu": "tsx scripts/merkez-kurtarma-kodu.ts",
    "merkez:linux-paket": "node scripts/merkez-linux-paket.mjs",
    "vds": "tsx --disable-warning=ExperimentalWarning scripts/vds.ts",
    "vds:cek": "tsx --disable-warning=ExperimentalWarning scripts/vds-cek.ts",
    "bilgisayar:yedek": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bilgisayar-yedek.ps1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/browser-tests.mjs",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e && tsx scripts/check-pilot-package.ts",
    "build": "vite build",
    "test:load": "tsx scripts/load-test.ts",
    "backup": "tsx scripts/backup.ts",
    "template:backup": "tsx scripts/starter-backup.ts",
    "demo:template": "tsx scripts/demo-template.ts",
    "pilot:check": "tsx scripts/pilot-preflight.ts",
    "pilot:package": "npm run build && node scripts/pilot-package.mjs",
    "installer": "node scripts/build-installer.mjs",
    "yayinla": "node scripts/yayinla.mjs",
    "islem:dogrula": "node scripts/islem-dogrula.mjs",
    "pdf:kilavuz": "tsx docs/pdf/kaynak/kilavuz/kilavuz.ts",
    "apk": "node scripts/build-apk.mjs",
    "dev:https": "tsx scripts/local-https.ts",
    "test:https": "tsx scripts/check-local-https.ts",
    "test:package": "npm run build && tsx scripts/check-pilot-package.ts",
    "test:paket": "tsx scripts/paket-testi.ts",
    "update:check": "tsx scripts/update-check.ts",
    "test:update": "npm run build && tsx scripts/check-update-rehearsal.ts",
    "site:build": "tsx scripts/site-build.ts",
    "site:dev": "tsx scripts/site-dev.ts",
    "site:videos": "tsx scripts/site-videos.ts",
    "site:indir": "tsx scripts/site-indir.ts",
    "ev-provasi": "tsx scripts/ev-provasi.ts",
    "pdf:belgeler": "node scripts/pdf-belgeler.mjs",
    "pdf:test-listesi": "node scripts/pdf-test-listesi.mjs",
    "pdf:hafta-sonu": "node scripts/pdf-test-listesi.mjs --kisa --kaynak=docs/HAFTA_SONU_SENARYOSU.md --cikti=docs/pdf/Mola-Hafta-Sonu-Senaryosu.pdf",
    "pdf:vds": "node scripts/pdf-test-listesi.mjs --kaynak=docs/VDS_KURULUM.md --kalip=docs/pdf/kaynak-vds/vds.html --cikti=docs/pdf/Mola-VDS-Kurulum-Rehberi.pdf"
  },
  "dependencies": {
    "express": "5.2.1",
    "lucide-react": "1.46.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
